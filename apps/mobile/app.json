{
  "expo": {
    "name": "Talorys",
    "slug": "talorys",
    "version": "0.3.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "talorys",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "dev.talorys.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#4C47E0",
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "talorys-lxl5w9o0-web.pages.dev",
              "pathPrefix": "/chat"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0B0B0E"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter_400Regular.ttf",
            "./assets/fonts/Inter_500Medium.ttf",
            "./assets/fonts/Inter_600SemiBold.ttf",
            "./assets/fonts/Heebo_400Regular.ttf",
            "./assets/fonts/Heebo_500Medium.ttf",
            "./assets/fonts/Heebo_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-monochrome.png",
          "color": "#4C47E0",
          "defaultChannel": "updates"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withReleaseSigning.js",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Talorys uses your approximate location to show the weather on Home.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "defaultServer": "https://talorys-lxl5w9o0-web.pages.dev"
    }
  }
}